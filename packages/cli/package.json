{
  "name": "@finazzle/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffolding CLI for the Finazzle workspace",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "finazzle": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest --run",
    "cli": "pnpm build && node dist/index.js",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "csv-parse": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.7",
    "eslint": "^8.57.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^7.13.1",
    "vitest": "^1.6.0"
  }
}
